10.MIRROR.JAVA
public class ReflectionMirror {
    public static void main(String[] args) {

        int n = 5;

        for (int i = 1; i <= n; i++) {

            // Left side numbers
            for (int j = 1; j <= i; j++) {
                System.out.print(j);
            }

            // Space between mirror
            for (int j = 1; j <= 2 * (n - i); j++) {
                System.out.print(" ");
            }

            // Right side reflection
            for (int j = i; j >= 1; j--) {
                System.out.print(j);
            }

            System.out.println();
        }
    }
}
