13.Find the missing number (1 to N).
import java.util.*;

public class MissingNumber {
    public static void main(String[] args) {
        int[] arr = {1, 2, 3, 5};

        int n = 5;
        int sum = 0;

        for (int x : arr)
            sum += x;

        System.out.println("Missing number = " + (n * (n + 1) / 2 - sum));
    }
}
