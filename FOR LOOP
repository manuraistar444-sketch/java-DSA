25. Find the equilibrium index.
public class Main {
    public static void main(String[] args) {
        int[] a = {1, 3, 5, 2, 2};

        int total = 0, left = 0;

        for (int x : a)
            total += x;

        for (int i = 0; i < a.length; i++) {
            total -= a[i];

            if (left == total) {
                System.out.println("Equilibrium Index = " + i);
                break;
            }

            left += a[i];
        }
    }
}
output:
Equilibrium Index = 2

